# Database
DATABASE_URL="postgresql://user:password@localhost:5432/smartstay?schema=public"

# Redis (for caching and room availability locks)
REDIS_URL="redis://localhost:6379"

# NextAuth
NEXTAUTH_SECRET="your-secret-key-here-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Paystack (Payment Gateway)
PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxxx"
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxx"
PAYSTACK_WEBHOOK_SECRET="your_paystack_webhook_secret"

# App URLs
FRONTEND_URL="http://localhost:3000"
ADMIN_URL="http://localhost:3001"
SUPER_ADMIN_URL="http://localhost:3002"

# Google Maps Platform (for location features)
GOOGLE_MAPS_API_KEY="AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# Email Configuration (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="noreply@hms.com"

# Security
SUPER_ADMIN_IP_WHITELIST="127.0.0.1,::1" # Comma-separated list of allowed IPs for super admin access

# Node Environment
NODE_ENV="development"
